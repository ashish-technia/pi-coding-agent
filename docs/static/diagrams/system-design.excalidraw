{"type":"text","id":"state_t1","x":70,"y":774,"width":330,"height":50,"text":"Durable: SQLite checkpoint per issue key\nstatus, plan, diff, verdict, iteration,\ncurrent_node, pending interrupt, task error","originalText":"Durable: SQLite checkpoint per issue key\nstatus, plan, diff, verdict, iteration,\ncurrent_node, pending interrupt, task error","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400011,"version":1,"versionNonce":400012,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
{"type":"text","id":"state_t2","x":70,"y":844,"width":330,"height":50,"text":"Ephemeral: running-task dict, progress map,\nqueue contents. Gone on restart; the next\nwebhook re-reads the checkpoint and resumes","originalText":"Ephemeral: running-task dict, progress map,\nqueue contents. Gone on restart; the next\nwebhook re-reads the checkpoint and resumes","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400013,"version":1,"versionNonce":400014,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
{"type":"text","id":"state_t3","x":70,"y":914,"width":330,"height":50,"text":"Repo: the git working tree itself.\nThe diff is read live, not stored, so\nhand edits to the clone change what is reviewed","originalText":"Repo: the git working tree itself.\nThe diff is read live, not stored, so\nhand edits to the clone change what is reviewed","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400015,"version":1,"versionNonce":400016,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
