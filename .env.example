# ---------------------------------------------------------------------------
# pi-jira-agent configuration. Copy to .env and fill in the secrets.
# ---------------------------------------------------------------------------

APP_NAME=pi-jira-agent
# Shared secret that Jira Automation / webhooks must send in x-webhook-secret.
WEBHOOK_SECRET=replace-me
# Comma-separated Jira project keys the agent may work on (empty = all).
ALLOWED_PROJECTS=WAAS,CORE
USE_QUEUE=true
QUEUE_MAX_SIZE=100

# --- Persistence -------------------------------------------------------------
# Postgres for checkpoints + run registry (recommended; `docker compose up -d`).
# Leave empty to use the SQLite file below (single process, local development).
DATABASE_URL=postgresql://pijira:pijira@localhost:5440/pijira
GRAPH_CHECKPOINT_DB=data/graph_checkpoints.sqlite
# Redis for the job queue (empty = in-memory queue).
REDIS_URL=redis://localhost:6390/0

# --- Pi coding harness (defaults for the planning and coding stages) --------
PI_API_KEY=replace-me
PI_PROVIDER=openai
PI_MODEL=gpt-5.4-medium
PI_SYSTEM_PROMPT=You are an engineering automation agent that prepares repository changes and PR content.
PI_NODE_COMMAND=node
PI_RUNNER_SCRIPT=node/pi-sdk-runner.mjs
PI_AGENT_DIR=.pi-agent
# One planning or coding call may take minutes on a real repository.
PI_TIMEOUT_SECONDS=600
# Pi sessions (planning or coding) allowed at once across all runs. Runs waiting at a
# gate do not count; extra runs wait for a free slot.
MAX_CONCURRENT_RUNS=2
# The agent's process starts with a minimal environment: PATH, HOME and the like, plus its
# model key. No other variable of this service reaches it. Name here (comma-separated) what
# it still needs, e.g. HTTPS_PROXY,NO_PROXY,NODE_EXTRA_CA_CERTS,JAVA_HOME
PI_ENV_PASSTHROUGH=
# Reasoning effort: off | minimal | low | medium | high | xhigh
PI_THINKING_LEVEL=medium

# --- Per-stage model overrides (all optional) ------------------------------
# Planning and coding fall back to PI_*; requirements falls back to REVIEW_*.
PLANNING_MODEL_PROVIDER=
PLANNING_MODEL=
PLANNING_API_KEY=
CODING_MODEL_PROVIDER=
CODING_MODEL=
CODING_API_KEY=
REQUIREMENTS_MODEL_PROVIDER=
REQUIREMENTS_MODEL=
REQUIREMENTS_API_KEY=
# Review agent: provider is openai | anthropic | google.
REVIEW_MODEL_PROVIDER=openai
REVIEW_MODEL=gpt-4.1
REVIEW_API_KEY=
REVIEW_MAX_ITERATIONS=2
# Largest diff (characters) sent to the review model. Above it whole files are left out,
# lockfiles and generated files first, and the gates say so. 0 = no limit.
REVIEW_MAX_DIFF_CHARS=200000
# Markdown file with must-check review rules, read on every review.
REVIEW_RULES_PATH=review-rules.md

# --- Repository & delivery ---------------------------------------------------
# JSON file listing every repository the agents may work in, so one run can span
# several (see docs: Getting started -> Repositories). Copy repos.example.json to
# repos.json and edit. When the file is missing, REPO_LOCAL_PATH below is the only
# repository and everything behaves as a single-repo setup.
REPOS_CONFIG_PATH=repos.json
# Where the clones live. Empty on a host, so the paths inside repos.json are used.
# Docker sets it to /workspace and clones each repo to /workspace/<name>, which is why
# the same repos.json works in both places.
REPOS_ROOT=
# Local clone of the target repository, used when repos.json is absent.
REPO_LOCAL_PATH=
GIT_REMOTE_NAME=origin
# Each run works in its own git worktree at <RUNS_ROOT>/<issue key>/<repo name>; the
# clones above are only fetched. Worktrees hold uncommitted work while a run waits at
# a gate, so keep this on storage that survives restarts.
RUNS_ROOT=data/runs
# Show the "Create PR" action and allow commit/push/PR. false = review only.
PR_CREATION_ENABLED=false

BITBUCKET_BASE_URL=https://api.bitbucket.org
BITBUCKET_WORKSPACE=workspace-key
# Default slug; each entry in repos.json can override it with its own.
BITBUCKET_REPO_SLUG=repo-slug
# Option A (recommended): bearer token auth
BITBUCKET_TOKEN=
# Option B: basic auth
BITBUCKET_USERNAME=user@example.com
BITBUCKET_APP_PASSWORD=replace-me
# Default PR destination; each entry in repos.json can override it.
BITBUCKET_TARGET_BRANCH=develop

# --- Jira ---------------------------------------------------------------------
JIRA_BASE_URL=https://your-company.atlassian.net
# In flow 2 this is the agent's dedicated service account.
JIRA_EMAIL=user@example.com
JIRA_API_TOKEN=replace-me
JIRA_TRANSITION_DONE_ID=
# Post status comments (cancelled / failed / PR created) to Jira.
JIRA_COMMENTS_ENABLED=true

# --- Flow 2: Jira-comment channel (off until the Automation rules exist) -----
JIRA_COMMENT_CHANNEL_ENABLED=false
# accountId of the agent's Jira user, so its own comments are ignored.
JIRA_AGENT_ACCOUNT_ID=
# Label that marks an issue for the agent (matches the Automation rule).
JIRA_TRIGGER_LABEL=ai-agent

# ---------------------------------------------------------------------------
# Docker (docker compose up -d --build). Only used when running in containers.
# Compose overrides REPO_LOCAL_PATH, DATABASE_URL, REDIS_URL and the SQLite path
# with container-internal values, so leave those set for host use above.
# ---------------------------------------------------------------------------
# Single-repository setups only: host path to the clone the agent works in, mounted
# read-write at /workspace/repo. With a repos.json the container clones each repository
# itself and this can stay unset.
TARGET_REPO_PATH=C:/projects/technia/your-repo
# Port the API is published on.
APP_PORT=8000
# Host ports for the bundled Postgres / Redis (container network is unaffected).
POSTGRES_PORT=5440
REDIS_PORT=6390
# Commit identity the coding agent uses inside the container.
GIT_AUTHOR_NAME=pi-jira-agent
GIT_AUTHOR_EMAIL=pi-jira-agent@localhost
# Only if you push over SSH and uncomment the .ssh mount in docker-compose.yml.
# SSH_DIR=C:/Users/you/.ssh
# Line endings in the mounted checkout, when the container's git disagrees with
# the host's: input (default) | true (Windows host, CRLF working tree) | false.
GIT_AUTOCRLF=input
# Override the HTTPS git username when the credential type needs a specific one
# (Atlassian API token -> your account email; access token -> x-token-auth).
# GIT_HTTPS_USERNAME=
# GIT_HTTPS_PASSWORD=
